# Anthropic (default)
# ANTHROPIC_API_KEY=sk-ant-...
# AGENT_MODEL=claude-sonnet-4-5
# AGENT_SMALL_MODEL=claude-haiku-4-5
# AGENT_EFFORT=high

# Or Anthropic-compatible (e.g. z.ai GLM)
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
# ANTHROPIC_AUTH_TOKEN=your_zai_api_key
# AGENT_API_PROFILE=compatible
# AGENT_MODEL=glm-4.6
# AGENT_SMALL_MODEL=glm-4.6

# Or OpenAI
# AGENT_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# AGENT_MODEL=gpt-4.1-mini
# AGENT_SMALL_MODEL=gpt-4o-mini

# AGENT_SAFETY=ask
# AGENT_CONTEXT_BUDGET=70000
# AGENT_MAX_STEPS=60
# AGENT_MAX_WORKERS=3
# AGENT_PROFILE_DIR=./profiles/default

# If Playwright Chromium download fails, use system browser:
# AGENT_BROWSER_CHANNEL=chrome
